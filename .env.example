PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/doctor-tracker?retryWrites=true&w=majority
CLIENT_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=doctor-tracker-api
JWT_AUDIENCE=doctor-tracker-client
ATLAS_DBUSERPASS=<atlas_db_password>
USER=<atlas_db_user>
